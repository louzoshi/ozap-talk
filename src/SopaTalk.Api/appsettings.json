{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=sopatalk;Username=sopatalk;Password=sopatalk",
    "Redis": "localhost:6379"
  },
  "Database": {
    // Aplica as migrations na subida do app. Sempre ligado em Development.
    // Em produção, só faz sentido com uma instância (ver deploy/macmini).
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "sopa-talk",
    "Audience": "sopa-talk-api",
    "SigningKey": "",
    "AccessTokenMinutes": 60
  },
  "Channels": {
    "WebhookVerifyToken": "",
    "AppSecret": "",
    "GraphApiVersion": "v21.0"
  },
  "Email": {
    "FromName": "sopa-talk",
    "FromAddress": "nao-responda@sopa.local",
    // Vazia: grava .eml em DropFolder em vez de enviar. Preenchida (via user-secrets ou
    // Email__ApiKey), envia de verdade pelo Resend. Nunca comitar valor aqui.
    "ApiKey": "",
    "DropFolder": "tmp/emails"
  },
  "Accounts": {
    "AppBaseUrl": "http://localhost:5173"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
