{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/OzapTalk.Api/bin/Debug/net10.0/OzapTalk.Api.dll",
      "cwd": "${workspaceFolder}/src/OzapTalk.Api",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/scalar/v1"
      }
    },
    {
      "name": "Workers",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/OzapTalk.Workers/bin/Debug/net10.0/OzapTalk.Workers.dll",
      "cwd": "${workspaceFolder}/src/OzapTalk.Workers",
      "env": { "DOTNET_ENVIRONMENT": "Development" },
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "API + Workers",
      "configurations": ["API", "Workers"],
      "stopAll": true
    }
  ]
}
