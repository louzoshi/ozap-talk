# Configuração e segredos do ozap-talk em produção.
# O setup.sh gera este arquivo em $OZAP_HOME/etc/ozap-talk.env com permissão 600.
# NUNCA versionar o arquivo real — só este exemplo.

# --- Banco -----------------------------------------------------------------
OZAP_DB_PASSWORD=troque-me
ConnectionStrings__Database=Host=localhost;Port=5432;Database=ozaptalk;Username=ozaptalk;Password=${OZAP_DB_PASSWORD}

# Aplica as migrations quando o app sobe. Seguro aqui: é uma instância só.
Database__MigrateOnStartup=true

# --- Aplicação -------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
# Só loopback: quem chega de fora entra pelo túnel, com HTTPS.
# Para liberar acesso direto na rede local, troque por http://0.0.0.0:5080
ASPNETCORE_URLS=http://127.0.0.1:5080

# Chave de assinatura do JWT. Trocar invalida todas as sessões abertas.
Jwt__SigningKey=troque-me
Jwt__AccessTokenMinutes=60

# URL pública, a mesma configurada no túnel. Usada nos links de convite.
Accounts__AppBaseUrl=https://atendimento.suaempresa.com.br

# --- WhatsApp Cloud API ----------------------------------------------------
# Token que você inventa e repete no painel da Meta ao registrar o webhook.
Channels__WebhookVerifyToken=troque-me
# App secret do app da Meta (Configurações > Básico). Valida X-Hub-Signature-256.
Channels__AppSecret=
Channels__GraphApiVersion=v21.0

# --- Runtime ---------------------------------------------------------------
# Descomente se o run-api.sh não achar o .NET sozinho.
# DOTNET_ROOT=/usr/local/share/dotnet
