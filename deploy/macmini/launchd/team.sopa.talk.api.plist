<?xml version="1.0" encoding="UTF-8"?>
<!-- API do sopa-talk. Instalado pelo setup.sh em ~/Library/LaunchAgents. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>team.sopa.talk.api</string>

  <key>ProgramArguments</key>
  <array>
    <string>__SOPA_HOME__/bin/run-api.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__SOPA_HOME__/app</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- Interactive mantém o processo fora do App Nap e da limitação de I/O. -->
  <key>ProcessType</key>
  <string>Interactive</string>

  <key>StandardOutPath</key>
  <string>__SOPA_HOME__/logs/api.log</string>
  <key>StandardErrorPath</key>
  <string>__SOPA_HOME__/logs/api.log</string>
</dict>
</plist>
